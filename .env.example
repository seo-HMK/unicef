# ──────────────────────────────────────────────────────────────────
# UNICEF SEO Dashboard · Variables de entorno
#
# Copia este archivo a .env.local (NO se sube a git) y rellena los valores.
# En Vercel: Settings → Environment Variables (NO uses .env.local en prod)
#
# Documentación completa: docs/ARQUITECTURA.md
# Setup GSC (para reenviar al webmaster del cliente): docs/CONFIGURAR_GSC.md
# ──────────────────────────────────────────────────────────────────


# ── Google Search Console (OAuth user-based) ──────────────────────
# Workspaces corporativos suelen bloquear service accounts como usuarios
# en GSC. Por eso usamos OAuth con cuenta delegada del cliente.
# Setup paso a paso en docs/CONFIGURAR_GSC.md.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_PROPERTY=sc-domain:unicef.es


# ── Google Analytics 4 ────────────────────────────────────────────
# Opción 1: Service account JSON (preferido, GA4 sí lo admite)
# Pega el contenido completo del JSON en una sola línea, o usa base64
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# Opción 2 (si Workspace bloquea SA): OAuth con cuenta delegada
# GA4_CLIENT_ID=
# GA4_CLIENT_SECRET=
# GA4_REFRESH_TOKEN=


# ── Ahrefs API v3 ─────────────────────────────────────────────────
# https://ahrefs.com/api · Plan Standard o superior
AHREFS_API_TOKEN=
AHREFS_TARGET=unicef.es


# ── Sistrix API ───────────────────────────────────────────────────
# https://www.sistrix.com/api
SISTRIX_API_KEY=
SISTRIX_DOMAIN=unicef.es


# ── Google Ads API (opcional, sólo para s11 reinversión) ──────────
# Setup más burocrático (Google revisa Developer Token).
# Si no se configura, el cálculo de reinversión queda como override manual.
# ADS_CLIENT_ID=
# ADS_CLIENT_SECRET=
# ADS_REFRESH_TOKEN=
# ADS_DEVELOPER_TOKEN=
# ADS_CUSTOMER_ID=


# ── Anthropic API (opcional, para resumen ejecutivo y recomendaciones) ──
# Genera textos narrativos en s6 y s7 a partir de los datos.
ANTHROPIC_API_KEY=


# ── JSONBin (cache compartido entre cron y data endpoint) ─────────
# https://jsonbin.io · plan gratuito suficiente
JSONBIN_MASTER_KEY=
JSONBIN_UNICEF_BIN_ID=


# ── Google Sheet del calendario editorial (s8 Días Mundiales) ─────
# ID del Google Sheet con columnas: fecha, dia_mundial, estado, url
CALENDAR_SHEET_ID=
CALENDAR_SHEET_RANGE=Calendario!A2:D


# ── Seguridad ─────────────────────────────────────────────────────
# Token que el dashboard envía al hacer refresh manual.
# Generar con cualquier string largo aleatorio (mínimo 32 caracteres).
SYNC_SECRET_TOKEN=


# ── Cliente ───────────────────────────────────────────────────────
CLIENT_ID=unicef
CLIENT_NAME=UNICEF España
DOMAIN=unicef.es
COUNTRY=es
BLOG_PATH=/blog/
CAUSAS_PATH=/causas/
EDUCA_PATH=/educa/
NOTICIA_PATH=/noticia/
COLABORA_PATH=/colabora/


# ── Umbrales para alertas/recomendaciones ─────────────────────────
THRESHOLD_CTR_CRITICAL=2.0
THRESHOLD_POSITION_CRITICAL=20
THRESHOLD_CLICKS_DROP_CRITICAL=500
